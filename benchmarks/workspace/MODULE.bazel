module(
    name = "pyrefly_benchmark",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "pyrefly.bzl", version = "0.5.0")
bazel_dep(name = "rules_pycross", version = "2.0.0-alpha.2")
bazel_dep(name = "rules_python", version = "2.0.0")

local_path_override(
    module_name = "pyrefly.bzl",
    path = "../..",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13.11",
)

pycross = use_extension(
    "@rules_pycross//pycross/extensions:pycross.bzl",
    "pycross",
)
pycross.configure_toolchains(
    platforms = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
    python_versions = ["3.13.11"],
)

uv = use_extension(
    "@rules_pycross//pycross/extensions:uv.bzl",
    "uv",
)
uv.workspace(
    name = "benchmark_pypi",
    lock_file = "//:uv.lock",
)
uv.repo(workspace = "benchmark_pypi")
use_repo(uv, "benchmark_pypi")

pyrefly = use_extension("@pyrefly.bzl", "pyrefly")
pyrefly.toolchain(version = "1.3.2")
use_repo(pyrefly, "pyrefly_toolchain")

register_toolchains("@pyrefly_toolchain//:all")
