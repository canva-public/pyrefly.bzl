load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)

string_flag(
    name = "log_level",
    build_setting_default = "error",
    values = [
        "debug",
        "info",
        "warning",
        "error",
        "critical",
    ],
)

toolchain_type(
    name = "toolchain_type",
)
