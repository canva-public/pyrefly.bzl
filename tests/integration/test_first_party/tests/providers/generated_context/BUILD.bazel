load("@pyrefly_testlib//:pytest.bzl", "pytest_test")
load("@rules_python//python:defs.bzl", "py_library")
load("//:pyrefly_aspects.bzl", "pyrefly_check_inputs", "pyrefly_check_test")
load("//testlib:python_contexts.bzl", "generated_python_context")

generated_python_context(
    name = "context",
    testonly = True,
)

py_library(
    name = "consumer",
    testonly = True,
    srcs = ["consumer.py"],
    deps = [":context"],
)

pyrefly_check_test(
    name = "check_test",
    target = ":consumer",
)

pyrefly_check_inputs(
    name = "inputs",
    testonly = True,
    target = ":consumer",
)

pytest_test(
    name = "output_test",
    srcs = ["output_test.py"],
    data = [":inputs"],
    deps = ["@pyrefly_testlib//:runfiles"],
)
